# Keep Android source code consistent across platforms.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.properties text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Store models, images, audio and the Gradle wrapper as binary files.
*.onnx binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ogg binary
*.mp4 binary
